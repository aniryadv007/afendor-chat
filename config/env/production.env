# SPDX-License-Identifier: AGPL-3.0-or-later
#
# Production environment configuration for Afendor Chat (afendor.cc)

AFENDOR_ENV=production
NODE_ENV=production
AFENDOR_BASE_DOMAIN=afendor.cc
AFENDOR_PUBLIC_SCHEME=https
AFENDOR_PUBLIC_PORT=443
AFENDOR_STATIC_CDN_DOMAIN=cdn.afendor.cc
AFENDOR_PUBLIC_URL=https://afendor.cc

# Endpoints
AFENDOR_API_ENDPOINT=https://api.afendor.cc
AFENDOR_API_CLIENT_ENDPOINT=https://api.afendor.cc
AFENDOR_APP_ENDPOINT=https://web.afendor.cc
AFENDOR_GATEWAY_ENDPOINT=wss://gateway.afendor.cc
AFENDOR_MEDIA_ENDPOINT=https://media.afendor.cc
AFENDOR_STATIC_CDN_ENDPOINT=https://cdn.afendor.cc
AFENDOR_ADMIN_ENDPOINT=https://admin.afendor.cc
AFENDOR_MARKETING_ENDPOINT=https://afendor.cc

AFENDOR_TRUST_CLIENT_IP_HEADER=true
AFENDOR_CLIENT_IP_HEADER_NAME=x-forwarded-for

# Database Backend (PostgreSQL)
AFENDOR_DATABASE_BACKEND=postgres
AFENDOR_POSTGRES_HOST=postgres
AFENDOR_POSTGRES_PORT=5432
AFENDOR_POSTGRES_DATABASE=afendor
AFENDOR_POSTGRES_USERNAME=afendor
AFENDOR_POSTGRES_PASSWORD=CHANGE_ME_IN_PRODUCTION
AFENDOR_POSTGRES_SSL=false
AFENDOR_POSTGRES_MAX_CONNECTIONS=50
AFENDOR_POSTGRES_KV_TABLE=afendor_kv
AFENDOR_KV_URL=redis://valkey:6379/0
AFENDOR_NATS_URL=nats://nats:4222
AFENDOR_NATS_JETSTREAM_URL=nats://nats:4222

# Internal Service Routing
AFENDOR_INTERNAL_API_ENDPOINT=http://127.0.0.1:8080
AFENDOR_INTERNAL_MEDIA_PROXY_ENDPOINT=http://127.0.0.1:8082
AFENDOR_MEDIA_PROXY_ENDPOINT=http://127.0.0.1:8082
AFENDOR_MEDIA_PROXY_PUBLIC_ENDPOINT=https://media.afendor.cc

AFENDOR_SVC_NATS_URL=nats://nats:4222
AFENDOR_SVC_SHARD_COUNT=1
AFENDOR_SVC_CACHE_TTL_MS=30000

# Object Storage (S3 / MinIO / SeaweedFS / Cloudflare R2 / AWS S3)
AFENDOR_S3_ENDPOINT=https://s3.your-region.amazonaws.com
AFENDOR_S3_PUBLIC_ENDPOINT=https://media.afendor.cc
AFENDOR_S3_REGION=auto
AFENDOR_S3_ACCESS_KEY_ID=CHANGE_ME
AFENDOR_S3_SECRET_ACCESS_KEY=CHANGE_ME
AFENDOR_S3_FORCE_PATH_STYLE=false
AFENDOR_S3_BUCKET_CDN=afendor-cdn
AFENDOR_S3_BUCKET_UPLOADS=afendor-uploads
AFENDOR_S3_BUCKET_REPORTS=afendor-reports
AFENDOR_S3_BUCKET_HARVESTS=afendor-harvests

# Voice & Video (LiveKit)
AFENDOR_LIVEKIT_ENABLED=true
AFENDOR_LIVEKIT_URL=wss://livekit.afendor.cc
AFENDOR_LIVEKIT_INTERNAL_URL=http://localhost:7880
AFENDOR_LIVEKIT_API_KEY=CHANGE_ME_KEY
AFENDOR_LIVEKIT_API_SECRET=CHANGE_ME_SECRET
AFENDOR_LIVEKIT_DEFAULT_REGION={"id":"default","name":"Global","emoji":"🌐","latitude":0.0,"longitude":0.0}

# Ports & Modes
AFENDOR_API_PORT=8080
AFENDOR_API_PRESIGNED_ATTACHMENT_UPLOADS_ENABLED=true
AFENDOR_API_WORKER_MODE=all_lanes
AFENDOR_APP_DEV_PORT=3000
AFENDOR_APP_PROXY_PORT=8773
AFENDOR_APP_PROXY_SAME_ORIGIN_HOSTS=web.afendor.cc,afendor.cc,web.canary.afendor.cc,canary.afendor.cc
AFENDOR_STATIC_DIR=afendor_app/dist

AFENDOR_MEDIA_PROXY_HOST=0.0.0.0
AFENDOR_MEDIA_PROXY_PORT=8082
AFENDOR_MEDIA_PROXY_SECRET_KEY=CHANGE_ME_MEDIA_SECRET
AFENDOR_MEDIA_PROXY_MODE=upload
AFENDOR_MEDIA_PROXY_STORAGE_BACKEND=s3
AFENDOR_MEDIA_PROXY_UPLOAD_RELAY_ENDPOINT=https://media.afendor.cc

AFENDOR_GATEWAY_PORT=8771
AFENDOR_GATEWAY_MEDIA_PROXY_ENDPOINT=https://media.afendor.cc
AFENDOR_GATEWAY_STATIC_CDN_ENDPOINT=https://cdn.afendor.cc
AFENDOR_GATEWAY_RPC_AUTH_TOKEN=CHANGE_ME_RPC_TOKEN
AFENDOR_GATEWAY_LOGGER_LEVEL=info

AFENDOR_ADMIN_PORT=3020
AFENDOR_ADMIN_BASE_PATH=/admin
AFENDOR_ADMIN_SECRET_KEY_BASE=CHANGE_ME_ADMIN_KEY_BASE
AFENDOR_ADMIN_OAUTH_CLIENT_SECRET=CHANGE_ME_ADMIN_OAUTH_SECRET
AFENDOR_ADMIN_OAUTH_REDIRECT_URI=https://admin.afendor.cc/oauth2_callback

# Security & Secrets
AFENDOR_SUDO_MODE_SECRET=CHANGE_ME_SUDO_SECRET
AFENDOR_CONNECTION_INITIATION_SECRET=CHANGE_ME_CONN_SECRET
AFENDOR_PROFILE_PSEUDONYM_SECRET=afendor-profile-pseudonym-secret
AFENDOR_VAPID_PUBLIC_KEY=CHANGE_ME_VAPID_PUBLIC
AFENDOR_VAPID_PRIVATE_KEY=CHANGE_ME_VAPID_PRIVATE
AFENDOR_VAPID_EMAIL=support@afendor.cc

# Passkey & WebAuthn
AFENDOR_PASSKEY_RP_NAME='Afendor Chat'
AFENDOR_PASSKEY_RP_ID=afendor.cc
AFENDOR_PASSKEY_ADDITIONAL_ALLOWED_ORIGINS=https://afendor.cc,https://web.afendor.cc

# Email Delivery
AFENDOR_EMAIL_ENABLED=true
AFENDOR_EMAIL_PROVIDER=smtp
AFENDOR_EMAIL_FROM='Afendor Chat <noreply@afendor.cc>'
AFENDOR_SMTP_HOST=smtp.yourprovider.com
AFENDOR_SMTP_PORT=587
AFENDOR_SMTP_SECURE=false
AFENDOR_SMTP_USERNAME=noreply@afendor.cc
AFENDOR_SMTP_PASSWORD=CHANGE_ME_SMTP_PASSWORD

# Registration Policy & Owner Claim
# Registration is public by default. The first user claims the Owner role with the setup token.
AFENDOR_REGISTRATION_MODE=public
AFENDOR_SETUP_TOKEN=CHANGE_ME_SETUP_TOKEN

# Branding & White-Labeling Defaults
AFENDOR_APP_PRODUCT_NAME='Afendor Chat'
AFENDOR_APP_THEME_COLOR='#9FE803'
AFENDOR_APP_ICON_URL=https://cdn.afendor.cc/web/android-chrome-512x512.png
AFENDOR_APP_SYMBOL_URL=https://cdn.afendor.cc/marketing/branding/symbol-white.svg
AFENDOR_APP_LOGO_URL=https://cdn.afendor.cc/marketing/branding/logo-color.svg
AFENDOR_APP_WORDMARK_URL=https://cdn.afendor.cc/marketing/branding/logo-color.svg
AFENDOR_APP_FAVICON_URL=https://cdn.afendor.cc/web/favicon-32x32.png
AFENDOR_APP_STATUS_PAGE_URL=https://status.afendor.cc

