{
	servers {
		trusted_proxies static private_ranges 127.0.0.1/32 172.16.0.0/12
		trusted_proxies_strict
		protocols h1 h2
	}
	admin off
}

(upstream) {
	reverse_proxy {args[0]} {
		header_up X-Forwarded-For {client_ip}
		header_up X-Real-IP {client_ip}
		header_up Host {host}
	}
}

:8080 {
	encode zstd gzip

	handle /_health {
		respond "OK" 200
	}

	# -------------------------------------------------------------
	# 1. API Subdomain (api.afendor.cc / api.*)
	# -------------------------------------------------------------
	@api host api.afendor.cc api.*
	handle @api {
		uri strip_prefix /api
		import upstream api:8080
	}

	# -------------------------------------------------------------
	# 2. Gateway Subdomain (gateway.afendor.cc / gateway.*)
	# -------------------------------------------------------------
	@gateway host gateway.afendor.cc gateway.*
	handle @gateway {
		uri strip_prefix /gateway
		import upstream gateway:8771
	}

	# -------------------------------------------------------------
	# 3. Media Subdomain (media.afendor.cc / media.*)
	# -------------------------------------------------------------
	@media host media.afendor.cc media.*
	handle @media {
		uri strip_prefix /media
		import upstream media-proxy:8082
	}

	# -------------------------------------------------------------
	# 4. Admin Subdomain (admin.afendor.cc / admin.*)
	# -------------------------------------------------------------
	@admin host admin.afendor.cc admin.*
	handle @admin {
		uri strip_prefix /admin
		import upstream admin:3020
	}

	# -------------------------------------------------------------
	# 5. LiveKit Subdomain (livekit.afendor.cc / livekit.*)
	# -------------------------------------------------------------
	@livekit host livekit.afendor.cc livekit.*
	handle @livekit {
		uri strip_prefix /livekit
		import upstream livekit:7880
	}

	# -------------------------------------------------------------
	# 6. Well-Known Discovery Handlers (All Domains)
	# -------------------------------------------------------------
	handle /.well-known/afendor {
		import upstream api:8080
	}

	handle /.well-known/fluxer {
		import upstream api:8080
	}

	handle /.well-known/webfinger {
		import upstream api:8080
	}

	# -------------------------------------------------------------
	# 7. Path-based Fallback Routing (for web.afendor.cc or afendor.cc)
	# -------------------------------------------------------------
	handle_path /api/* {
		import upstream api:8080
	}

	handle /gateway {
		rewrite * /
		import upstream gateway:8771
	}

	handle_path /gateway/* {
		import upstream gateway:8771
	}

	handle_path /media/* {
		import upstream media-proxy:8082
	}

	handle_path /livekit/* {
		import upstream livekit:7880
	}

	handle /admin {
		rewrite * /
		import upstream admin:3020
	}

	handle_path /admin/* {
		import upstream admin:3020
	}

	# -------------------------------------------------------------
	# 8. Frontend SPA App Proxy (Default Fallback)
	# -------------------------------------------------------------
	handle {
		import upstream app-proxy:8773
	}
}
