# ==============================================================================
# AFENDOR CHAT - NGINX HOST REVERSE PROXY CONFIGURATION TEMPLATE
# Dynamically compiled by afendorctl / deploy/scripts/nginx-manage.sh
# Target: /etc/nginx/sites-available/afendor.conf
# ==============================================================================

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# ------------------------------------------------------------------------------
# 1. HTTP -> HTTPS REDIRECT & ACME WEBROOT CHALLENGE FOR ALL SUBDOMAINS
# ------------------------------------------------------------------------------
server {
    listen 80;
    listen [::]:80;
    server_name {{DOMAIN}} *.{{DOMAIN}};

    # Let's Encrypt Certbot ACME Webroot Challenge
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
        try_files $uri =404;
    }

    # Redirect all HTTP to HTTPS
    location / {
        return 301 https://$host$request_uri;
    }
}

# ------------------------------------------------------------------------------
# 2. MAIN WEB APP, API, GATEWAY, MEDIA, CDN, ADMIN
# ------------------------------------------------------------------------------
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name {{DOMAIN}} web.{{DOMAIN}} api.{{DOMAIN}} gateway.{{DOMAIN}} media.{{DOMAIN}} cdn.{{DOMAIN}} admin.{{DOMAIN}};

    # TLS Certificate Paths
    ssl_certificate {{SSL_CERT_PATH}};
    ssl_certificate_key {{SSL_KEY_PATH}};
    ssl_session_timeout 1d;
    ssl_session_cache shared:AfendorSSL:50m;
    ssl_session_tickets off;

    # Modern TLS Security Configuration
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers off;

    # HSTS Security Header (6 months)
    add_header Strict-Transport-Security "max-age=15768000; includeSubDomains" always;

    # File Upload Limits
    client_max_body_size 100M;
    client_body_buffer_size 1M;

    # Proxy Headers
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Port $server_port;

    # WebSocket Upgrade
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;

    # Timeouts for Long-Polling / WebSockets
    proxy_read_timeout 86400s;
    proxy_send_timeout 86400s;
    proxy_connect_timeout 60s;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
        try_files $uri =404;
    }

    # Internal Edge Ingress Dispatcher
    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_buffering off;
    }
}

# ------------------------------------------------------------------------------
# 3. LIVEKIT WEBRTC SIGNALING
# ------------------------------------------------------------------------------
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name livekit.{{DOMAIN}};

    ssl_certificate {{SSL_CERT_PATH}};
    ssl_certificate_key {{SSL_KEY_PATH}};

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;

    proxy_read_timeout 86400s;
    proxy_send_timeout 86400s;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
        try_files $uri =404;
    }

    # LiveKit HTTP & WebSocket Signaling
    location / {
        proxy_pass http://127.0.0.1:7880;
        proxy_buffering off;
    }
}

